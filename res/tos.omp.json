{
  "version": 4,
  "final_space": true,
  "palette": {
    "path": "#ABB2BF",
    "drive": "#C96B33",
    "folder": "#E5C07B",
    "clean": "#98C379",
    "changed": "#D19A66",
    "error": "#E06C75",
    "muted": "#7F848E",
    "rail": "#596574"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:error{{ end }}"
    ],
    "template": "󰶻 ",
    "newline": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╭─╴"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:muted",
          "foreground_templates": [
            "{{ if .Root }}p:error{{ else if .SSHSession }}p:changed{{ end }}"
          ],
          "template": "{{ if .Root }} admin <p:rail>·</> {{ else if .SSHSession }} {{ .UserName }}@{{ .HostName }} <p:rail>·</> {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:path",
          "options": {
            "style": "agnoster_short",
            "max_depth": 2,
            "folder_icon": "…",
            "folder_separator_icon": "<p:path>/</>",
            "left_format": "<p:path>%s</>",
            "right_format": "<p:folder>%s</>"
          },
          "template": "<p:drive></> {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "min_width": 60,
          "foreground": "p:clean",
          "foreground_templates": [
            "{{ if or (gt .Working.Unmerged 0) (gt .Staging.Unmerged 0) }}p:error{{ else if or .Working.Changed .Staging.Changed }}p:changed{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "branch_max_length": 24,
            "truncate_symbol": "…",
            "branch_icon": " "
          },
          "template": "<p:rail>╶─╴</> {{ .HEAD }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if .Staging.Changed }} +{{ .Staging.String }}{{ end }}{{ if .Working.Changed }} ~{{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} *{{ .StashCount }}{{ end }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:muted",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "display_default": false
          },
          "template": "<p:rail>╶─╴</>  {{ if .Venv }}{{ .Venv }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╶"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "filler": "<p:rail>─</>",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "min_width": 60,
          "foreground": "p:error",
          "options": {
            "always_enabled": false
          },
          "template": "<p:rail>╴</>  {{ .Code }} <p:rail>╶</>"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "min_width": 60,
          "foreground": "p:changed",
          "options": {
            "style": "austin",
            "threshold": 500,
            "always_enabled": false
          },
          "template": "<p:rail>╴</>  {{ .FormattedMs }} <p:rail>╶</>"
        },
        {
          "type": "time",
          "style": "plain",
          "min_width": 50,
          "foreground": "p:muted",
          "options": {
            "time_format": "15:04"
          },
          "template": "<p:rail>╴</> <p:drive></> {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╶─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╰─╴"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:clean",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "template": "󰶻"
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hide",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:rail",
          "template": "╶─╯"
        }
      ]
    }
  ]
}
