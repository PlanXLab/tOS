{
  "$schema": "https://githubusercontent.com",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "\uE0BC",
          "foreground": "p:black",
          "background": "p:muted_blue",
          "template": " {{ if .WSL }}WSL{{ else }}{{ .Icon }}{{ end }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\uE0BC",
          "foreground": "p:fg_light",
          "background": "p:bg_dark",
          "background_templates": [
            "{{ if .Root }}p:root_bg{{ end }}"
          ],
          "template": "    {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\uE0BC",
          "foreground": "p:fg_white",
          "background": "p:slate_blue",
          "properties": {
            "style": "unique"
          },
          "template": "    {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\uE0BC",
          "foreground": "p:black",
          "background": "p:sage_green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:soft_gold{{ end }}",
            "{{ if gt .HEAD.Behind 0 }}p:root_bg{{ end }}"
          ],
          "properties": {
            "branch_max_length": 32,
            "fetch_status": true
          },
          "template": "    {{ .HEAD }}{{ if gt .Behind 0 }}    {{ .Behind }}{{ end }}{{ if gt .Ahead 0 }}    {{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }}    {{ .StashCount }}{{ end }}{{ if gt .Working.Unmerged 0 }}    {{ .Working.Unmerged }}{{ end }}{{ if gt .Staging.Changed 0 }}    {{ .Staging.Changed }}{{ end }}{{ if gt .Working.Modified 0 }}    {{ .Working.Modified }}{{ end }}{{ if gt .Working.Untracked 0 }}    {{ .Working.Untracked }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\uE0BA",
          "invert_powerline": true,
          "foreground": "p:black",
          "background": "p:sage_green",
          "background_templates": [
            "{{ if .Error }}p:root_bg{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if .Error }}   {{ .Code }}{{ else }}  {{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\uE0BA",
          "invert_powerline": true,
          "foreground": "p:black",
          "background": "p:exec_bg",
          "properties": {
            "style": "austin",
            "threshold": 500
          },
          "template": "    {{ .FormattedMs }} "
        },
        {
          "type": "command",
          "style": "powerline",
          "powerline_symbol": "\uE0BA",
          "invert_powerline": true,
          "foreground": "p:black",
          "background": "p:temp_bg",
          "properties": {
            "shell": "sh",
            "command": "if [ -f /sys/class/thermal/thermal_zone0/temp ]; then awk '{printf \"%d°C\", $1/1000}' /sys/class/thermal/thermal_zone0/temp; fi"
          },
          "template": "  {{ .Output }} "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\uE0BA",
          "invert_powerline": true,
          "foreground": "p:black",
          "background": "p:sage_green",
          "template": "    {{ round .PhysicalPercentUsed .Precision }}% "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\uE0BA",
          "invert_powerline": true,
          "foreground": "p:fg_white",
          "background": "p:slate_blue",
          "template": "    {{ round .MemoryPercentUsed .Precision }}% "
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\uE0BA",
          "invert_powerline": true,
          "foreground": "p:black",
          "background": "p:muted_blue",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "    {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:muted_blue",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:root_bg{{ end }}"
          ],
          "template": "⚡"
        }
      ]
    }
  ],
  "palette": {
    "black": "#1c1c1c",
    "frame": "#6c6c6c",
    "muted_blue": "#87afaf",
    "bg_dark": "#444444",
    "fg_light": "#bcbcbc",
    "fg_white": "#dadada",
    "root_bg": "#af5f5f",
    "slate_blue": "#5f87af",
    "sage_green": "#87af87",
    "soft_gold": "#dfaf5f",
    "exec_bg": "#afaf5f",
    "temp_bg": "#df875f"
  }
}
