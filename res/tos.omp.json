{
  "$schema": "https://planxlab.com",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "filler": "<#3a3a3a>·</>",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "background": "#87afaf",
          "foreground": "#080808",
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "background": "#444444",
          "foreground": "#bcbcbc",
          "background_templates": [
            "{{ if .Root }}#af5f5f{{ end }}"
          ],
          "foreground_templates": [
            "{{ if .Root }}#dadada{{ end }}"
          ],
          "template": "    {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "background": "#5f87af",
          "foreground": "#dadada",
          "properties": {
            "style": "fish",
            "dir_length": 1
          },
          "template": "    {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0bc",
          "background": "#87af87",
          "foreground": "#080808",
          "background_templates": [
            "{{ if or (gt .Working.Unmerged 0) (gt .Staging.Unmerged 0) }}#af5f5f{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#d7af5f{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "branch_max_length": 32,
            "truncate_symbol": "…",
            "branch_icon": "   "
          },
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }}    {{ .Behind }}{{ end }}{{ if gt .Ahead 0 }}    {{ .Ahead }}{{ end }}{{ if gt .StashCount 0 }}    {{ .StashCount }}{{ end }}{{ if gt .Staging.Unmerged 0 }} <#dadada>   {{ .Staging.Unmerged }}</>{{ end }}{{ if gt .Staging.Changed 0 }}    {{ .Staging.Total }}{{ end }}{{ if gt .Working.Modified 0 }}    {{ .Working.Modified }}{{ end }}{{ if gt .Working.Untracked 0 }}    {{ .Working.Untracked }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0ba",
          "invert_powerline": true,
          "background": "#262626",
          "foreground": "#87af87",
          "background_templates": [
            "{{ if gt .Code 0 }}#af5f5f{{ end }}"
          ],
          "foreground_templates": [
            "{{ if gt .Code 0 }}#dadada{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }}✘ {{ .Code }}{{ else }}  {{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0ba",
          "invert_powerline": true,
          "background": "#afaf5f",
          "foreground": "#080808",
          "properties": {
            "style": "austin",
            "threshold": 500
          },
          "template": "    {{ .FormattedMs }} "
        },
        {
          "type": "command",
          "style": "powerline",
          "powerline_symbol": "\ue0ba",
          "invert_powerline": true,
          "background": "#d7875f",
          "foreground": "#080808",
          "properties": {
            "shell": "sh",
            "command": "awk '{printf \"%.0f°C\", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null"
          },
          "template": "{{ if .Output }}  {{ .Output }} {{ end }}"
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0ba",
          "invert_powerline": true,
          "background": "#87af87",
          "foreground": "#080808",
          "template": "    {{ round .PhysicalPercentUsed .Precision }}% "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "powerline_symbol": "\ue0ba",
          "invert_powerline": true,
          "background": "#5f87af",
          "foreground": "#dadada",
          "template": "    {{ (div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1073741824.0) | round 1 }}G "
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\ue0ba",
          "invert_powerline": true,
          "background": "#87afaf",
          "foreground": "#080808",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "    {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "template": "─╮"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#87afaf",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#af5f5f{{ end }}"
          ],
          "template": "⚡"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#6c6c6c",
          "template": "─╯"
        }
      ]
    }
  ]
}
